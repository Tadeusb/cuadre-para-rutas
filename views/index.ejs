<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f1f4f0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
    <title><%= title %></title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Cuadre, inicio">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>cuadre<span class="brand-dot">.</span></span>
      </a>
      <div class="topbar-actions">
        <span class="local-status"
          ><span class="status-dot"></span> Borrador local</span
        >
        <button
          class="icon-button"
          id="reset-button"
          type="button"
          title="Empezar un nuevo cuadre"
          aria-label="Empezar un nuevo cuadre"
        >
          ↺
        </button>
      </div>
    </header>

    <main class="app-shell">
      <div class="page-heading">
        <div>
          <p class="eyebrow">OPERACIONES <span>/</span> LIQUIDACIÓN</p>
          <h1>Cuadre de ruta</h1>
          <p class="page-subtitle">
            Registra los movimientos del recorrido y revisa el saldo.
          </p>
        </div>
        <div class="date-stamp" id="today-stamp"></div>
      </div>

      <div class="workspace">
        <section class="flow-panel" aria-label="Formulario de cuadre">
          <nav
            class="step-nav"
            id="step-nav"
            aria-label="Etapas del cuadre"
          ></nav>
          <div class="step-meta">
            <span id="step-count"></span>
            <span class="step-progress-track"
              ><span id="step-progress"></span
            ></span>
          </div>
          <form id="step-form" novalidate>
            <div id="step-content"></div>
            <div class="form-error" id="form-error" role="alert" hidden></div>
            <footer class="form-footer">
              <button
                class="button button-quiet"
                id="back-button"
                type="button"
              >
                ← <span>Anterior</span>
              </button>
              <span class="footer-note"
                >Los cambios se conservan mientras esta página esté
                abierta.</span
              >
              <button
                class="button button-primary"
                id="next-button"
                type="submit"
              >
                <span>Siguiente</span> <span aria-hidden="true">→</span>
              </button>
            </footer>
          </form>
        </section>

        <aside class="summary-panel" aria-label="Resumen del cuadre">
          <div class="summary-heading">
            <div>
              <p class="eyebrow">VISTA PREVIA</p>
              <h2>Resumen</h2>
            </div>
            <span class="summary-live"
              ><span class="status-dot"></span> En vivo</span
            >
          </div>
          <div class="route-preview" id="route-preview">
            <span class="route-icon" aria-hidden="true">↗</span>
            <div>
              <strong id="preview-driver">Sin conductor</strong
              ><span id="preview-route">Zona y placa pendientes</span>
            </div>
          </div>
          <div class="balance-block" id="balance-block">
            <span>Saldo de ruta</span>
            <strong id="balance-value">$ 0</strong>
            <span class="balance-status" id="balance-status">Cuadrado</span>
          </div>
          <div class="summary-breakdown">
            <div class="summary-line summary-base">
              <span>Planilla</span><strong id="sum-planilla">$ 0</strong>
            </div>
            <div class="summary-line">
              <span>Abonos</span><strong id="sum-abonos">$ 0</strong>
            </div>
            <div class="summary-line deduction">
              <span>Cambios</span><strong id="sum-cambios">− $ 0</strong>
            </div>
            <div class="summary-divider"></div>
            <div class="summary-line">
              <span>Devoluciones</span
              ><strong id="sum-devoluciones">− $ 0</strong>
            </div>
            <div class="summary-line">
              <span>Retenciones</span
              ><strong id="sum-retenciones">− $ 0</strong>
            </div>
            <div class="summary-line">
              <span>Gastos de ruta</span><strong id="sum-gastos">− $ 0</strong>
            </div>
            <div class="summary-line">
              <span>Consignaciones</span
              ><strong id="sum-consignaciones">− $ 0</strong>
            </div>
          </div>
          <button
            class="button button-download"
            id="download-button"
            type="button"
            disabled
          >
            <span aria-hidden="true">↓</span> Descargar PDF
          </button>
          <p class="summary-footnote">
            El saldo se calcula con los datos ingresados en este cuadre.
          </p>
        </aside>
      </div>
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>
